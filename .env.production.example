# Copy to .env on the server (never commit it) and fill in every value.
# Generate secrets with: openssl rand -hex 32   (hex: safe inside URLs)

# --- Reverse proxy: pick ONE ---
# A) The server already runs a reverse proxy (e.g. Caddy) in Docker:
#    the Docker network it uses (docker inspect <caddy-container>). Add
#    deploy/Caddyfile.snippet to its Caddyfile.
PROXY_NETWORK=
# B) Empty server: use the bundled Caddy (HTTPS for DOMAIN):
# COMPOSE_PROFILES=caddy
DOMAIN=programari.exemplu.ro          # DNS A/AAAA record must point to this server
ACME_EMAIL=you@example.ro             # Let's Encrypt expiry notices (bundled Caddy only)

# Loopback ports on the server; change if other containers already use them.
APP_HOST_PORT=3000
DB_HOST_PORT=5432

# --- Database (container "db") ---
POSTGRES_DB=glowi
POSTGRES_USER=glowi
POSTGRES_PASSWORD=                    # openssl rand -hex 24  (letters/digits only)

# --- App ---
SESSION_SECRET=                       # openssl rand -base64 32
CRON_SECRET=                          # openssl rand -hex 32
SALON_NAME="Stylish Salon"            # fallback; the admin sets it in Profil
SALON_PHONE=

# --- First admin (used only by the seed: deploy/README "First deploy") ---
ADMIN_EMAIL=
ADMIN_PASSWORD=                       # at least 10 characters; change it in Profil afterwards

# --- SMSLink ---
SMSLINK_CONNECTION_ID=
SMSLINK_PASSWORD=
SMSLINK_TEST=0                        # 1 = simulate, nothing delivered
SMSLINK_SENDER=                       # only after SMSLink approved the name
# SMS_REDIRECT_TO=07xxxxxxxx          # TESTING ONLY: every SMS goes to this number

# --- Backups ---
BACKUP_KEEP_DAYS=14
